# ============================================================
# FORYXO MENU — Environment Variables
# Copy to .env.local (dev) or inject via secret manager (prod).
# NEVER commit real secrets.
# ============================================================

# ---------- APP ----------
APP_NAME="Foryxo Menu"
APP_URL=http://localhost:3000            # Public base URL (e.g. https://menu.foryxo.com)
NODE_ENV=development
# Comma-separated feature flags. Omit = disabled.
FEATURE_FLAGS="mockPayments,demoMode"
# One of: pglite (dev default) | postgres (production)
DB_DRIVER=pglite
# Local directory for PGLite data + local file storage
DATA_DIR=./.data

# ---------- DATABASE (DATABASE_) ----------
# Only required when DB_DRIVER=postgres
DATABASE_URL=
DATABASE_POOL_MAX=10

# ---------- REDIS (REDIS_) ----------
# Optional: when unset, BullMQ/rate-limiters fall back to in-memory dev mode.
REDIS_URL=

# ---------- AUTH (AUTH_) ----------
AUTH_SECRET=change-me-32-bytes-min-random-dev-secret
AUTH_URL=http://localhost:3000
# Dev OTP is logged to console and uses a random 6-digit code (never use in prod).
# Production never enables a console-only OTP sender, regardless of this setting.
AUTH_DEV_OTP=false

# ---------- GOOGLE (GOOGLE_) ----------
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- EMAIL (EMAIL_) ----------
# console (development only) | resend (production, verified domain required)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Foryxo <otp@foryxo.com>"

# ---------- SMS (SMS_) ----------
# console (development only) | kavenegar | generic (HTTPS + bearer key in prod)
# For Kavenegar, create the `foryxo-otp` verify template in your account.
SMS_PROVIDER=console
SMS_KAVENEGAR_API_KEY=
SMS_GENERIC_URL=
SMS_GENERIC_KEY=

# ---------- ZARINPAL (ZARINPAL_) ----------
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# YekPay international checkout is not activated by environment variables yet.
# Merchant onboarding and the documented WebGate request/verify contract are required.

# ---------- STORAGE (STORAGE_) ----------
# local (dev default) | s3 (Cloudflare R2 / AWS S3 compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- SENTRY (SENTRY_) ----------
SENTRY_DSN=

# ---------- INDEXNOW (INDEXNOW_) ----------
INDEXNOW_KEY=

# Staff accounts use the same email OTP login as everyone else. Run
# `npm run staff:bootstrap` after migrations to enforce these server-side roles.
ADMIN_EMAIL=foryxolabels@gmail.com
CREATOR_EMAIL=yasaminsoraghi84@gmail.com

# Legacy one-time password provisioning (optional). Prefer staff:bootstrap + OTP.
OWNER_EMAIL=foryxolabels@gmail.com
OWNER_BOOTSTRAP_PASSWORD=
